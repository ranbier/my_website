{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dmdnot-website",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true,
  },
  "build": {
    "command": "npm run build",
  },
  "assets": {
    "directory": "./dist",
  },
  "compatibility_flags": ["nodejs_compat"],
}
